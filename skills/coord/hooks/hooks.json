{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\"", "timeout": 20 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git *)", "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\"", "timeout": 30 },
          { "type": "command", "if": "Bash(gh *)", "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\"", "timeout": 30 },
          { "type": "command", "if": "Bash(npm *)", "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "command -v node >/dev/null 2>&1 || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/bin/hook.mjs\"", "timeout": 10 }] }
    ]
  }
}
