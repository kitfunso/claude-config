# Global Claude Code config repo — allowlist .gitignore.
# Ignore everything by default, then permit ONLY the shareable files.
# This guarantees secrets and local state can never be staged, even by an
# accidental `git add -A`: settings.json (API keys), settings.local.json,
# projects/ (memory + sessions), plugins/, voice/, sessions/, history.jsonl,
# todos/, statsig/, shell-snapshots/, *.old backups, etc.
*
!/CLAUDE.md
!/docs/
!/docs/**
!/rules/
!/rules/**
!/skills/
!/skills/**
!/hooks/
!/hooks/**
!/scripts/
!/scripts/**
!/.gitignore

# Keep shareable skill and hook source, not vendored dependencies, nested repos,
# generated bundles, or local binary artifacts.
/skills/**/.git/
/skills/**/.git/**
/skills/**/node_modules/
/skills/**/node_modules/**
/skills/**/dist/
/skills/**/dist/**
/skills/**/__pycache__/
/skills/**/__pycache__/**
/skills/frontend-slides/
/skills/frontend-slides/**
/skills/gstack/
/skills/gstack/**
/skills/**/*.pyc
/skills/**/*.exe
/skills/**/*.dll
/skills/**/*.dylib
/skills/**/*.so
/skills/**/*.node
/skills/**/*.wasm
/skills/**/*.pack
/skills/**/*.idx
/skills/**/*.zip
/skills/**/*.gz
/scripts/**/__pycache__/
/scripts/**/__pycache__/**
/scripts/**/*.pyc

# pre-write-guard.js backups, in every permitted directory. The per-directory
# forms missed /rules/, so 5 .old files were staged before this rule existed.
**/*.old
**/*.old-*
